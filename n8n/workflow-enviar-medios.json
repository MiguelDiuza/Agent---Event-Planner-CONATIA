      ],
      "onError": "continueRegularOutput",
      "notes": "Falta 'Sender Phone Number' (phoneNumberId): se elige de una lista que solo carga con la credencial de Meta conectada. mediaPath useMediaLink manda la URL publica de Supabase Storage y Meta la descarga.",
      "credentials": {},
      "parameters": {
        "operation": "send",
        "messageType": "video",
        "mediaPath": "useMediaLink",
        "recipientPhoneNumber": "={{ $('Entrada de la Herramienta').first().json.telefono }}",
        "mediaLink": "={{ $json.url }}",
        "additionalFields": {
          "mediaCaption": "={{ $json.caption }}"
        }
      },
      "webhookId": "a3dad107-a154-4007-be0d-9fd77d0cadd2"
    },
    {
      "id": "ed000000-0000-4000-8000-000000000008",
