{
  "name": "Christian Sierra — Herramienta: enviar_medios",
  "nodes": [
    {
      "id": "ed000000-0000-4000-8000-000000000001",
      "name": "Entrada de la Herramienta",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -420,
        300
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "categoria",
              "type": "string"
            },
            {
              "name": "referencia",
              "type": "string"
            },
            {
              "name": "tipo_medio",
