      }
    },
    {
      "id": "ed000000-0000-4000-8000-000000000002",
      "name": "Seleccionar Medios",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -180,
        300
      ],
      "alwaysOutputData": true,
      "notes": "alwaysOutputData es obligatorio: sin filas el nodo no emite items, n8n salta todo lo que sigue y la rama de diagnostico nunca corre, dejando al agente sin respuesta.",
      "credentials": {
        "postgres": {
          "id": "ErY9RiTjTsXVB0JC",
          "name": "Supabase - Christian Sierra"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from fn_medios_para_enviar($1, $2, $3, $4)",
        "options": {
          "queryReplacement": "={{ [$json.categoria, $json.referencia, $json.telefono, $json.tipo_medio || 'ambos'] }}"
        }
      }
    },
    {
      "id": "ed000000-0000-4000-8000-000000000003",
      "name": "¿Hay medios?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        60,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-hay-medios",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "ed000000-0000-4000-8000-000000000004",
      "name": "Diagnóstico",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        300,
        480
      ],
      "notes": "Distingue 'ya se lo enviaste todo' de 'esa referencia no existe'. Sin esa distincion el agente le diria a un cliente que no hay fotos de una sede de la que acaba de mandarle fotos.",
      "credentials": {
        "postgres": {
          "id": "ErY9RiTjTsXVB0JC",
          "name": "Supabase - Christian Sierra"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "select\n    case\n        when d.total_existentes > 0\n            then 'Ya le enviaste todo el material disponible de esa referencia a este cliente. No lo repitas: refiérete a lo que ya vio contigo.'\n        else 'No hay medios para esa referencia. Con material disponible: ' || coalesce(d.referencias_disponibles, 'ninguna') || '. Vuelve a intentarlo con una de esas, o continúa la conversación sin enviar material.'\n    end as resultado\nfrom fn_medios_diagnostico($1, $2, $3) d",
        "options": {
          "queryReplacement": "={{ [$('Entrada de la Herramienta').first().json.categoria, $('Entrada de la Herramienta').first().json.referencia, $('Entrada de la Herramienta').first().json.tipo_medio || 'ambos'] }}"
        }
      }
    },
    {
      "id": "ed000000-0000-4000-8000-000000000005",
      "name": "Recorrer Medios",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        300,
        160
      ],
      "notes": "Salida 0 = done (resumen), salida 1 = loop (un medio por vuelta).",
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "ed000000-0000-4000-8000-000000000006",
      "name": "¿Es video?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        540,
        280
      ],
      "parameters": {
        "conditions": {
