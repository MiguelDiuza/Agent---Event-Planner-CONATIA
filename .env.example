# =============================================================================
# Variables de entorno — Christian Sierra Event Planner / Agente "Brian Otero"
# =============================================================================
# Copia este archivo a `.env` y rellena los valores.
#   cp .env.example .env
#
# `.env` está en .gitignore. NUNCA lo commitees, y nunca pegues valores reales
# aquí: este archivo SÍ se versiona.
#
# Ojo con el alcance: no todo lo del proyecto se configura por entorno.
#   - Supabase CLI    -> sí lee estas variables (SUPABASE_ACCESS_TOKEN).
#   - n8n (servidor)  -> lee las N8N_* al arrancar.
#   - Credenciales de los nodos de n8n (Postgres, Google, WhatsApp) -> NO.
#     Viven cifradas dentro de ~/.n8n/database.sqlite y solo se editan desde
#     la UI de n8n. Aquí abajo se documentan sus IDs para poder ubicarlas.
# -----------------------------------------------------------------------------

# --- Supabase Cloud (producción) ---------------------------------------------
# Project ref y URL no son secretos.
SUPABASE_PROJECT_REF=vzxcqoqljnndoxmzgfda
SUPABASE_URL=https://vzxcqoqljnndoxmzgfda.supabase.co

# Token personal del CLI. Caduca ~30 días.
# Se genera en https://supabase.com/dashboard/account/tokens
# Uso: export $(grep -v '^#' .env | xargs) && supabase db query --linked "SQL"
SUPABASE_ACCESS_TOKEN=

# Contraseña de la base de datos del proyecto (Dashboard > Settings > Database).
# La usa la credencial Postgres de n8n; aquí solo para scripts locales.
SUPABASE_DB_PASSWORD=

# Conexión vía pooler (la reporta `supabase link`, ver supabase/.temp/pooler-url)
SUPABASE_POOLER_URL=postgresql://postgres.vzxcqoqljnndoxmzgfda@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# --- Supabase local (`supabase start`) ---------------------------------------
# Puertos fijados en supabase/config.toml. No hace falta tocarlos.
SUPABASE_LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_LOCAL_STUDIO_URL=http://127.0.0.1:54323

# --- n8n local ---------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678

# API key de n8n (Settings > n8n API en la UI). Header: X-N8N-API-KEY.
# Caducan a los ~30 días; si el MCP o los scripts fallan, revisa esto primero.
N8N_API_KEY=

# IDs de referencia (no son secretos, sirven para ubicar cosas rápido)
N8N_WORKFLOW_BRIAN_OTERO=JpODij1ebqkRSAc1
N8N_CREDENTIAL_POSTGRES_SUPABASE=ErY9RiTjTsXVB0JC

# Webhook del canal de prueba local (Chat Trigger)
N8N_CHAT_TEST_WEBHOOK=3f9c1d27-5b84-4e16-9a70-2d5c8e1b4f33

# --- Google OAuth (Google Calendar en n8n) -----------------------------------
# El Client ID no es secreto; el Secret sí.
# Se rotan en https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5678/rest/oauth2-credential/callback

# --- WhatsApp vía YCloud (conexión definitiva) -------------------------------
# Coexistencia: el numero sigue vivo en la app de WhatsApp Business y a la vez
# habla por la Cloud API. Nada de esto es secreto salvo el API key.
#
# OJO: hay dos cuentas de YCloud. El key de la cuenta vieja (numero
# +573182899705) devuelve 403 contra esta WABA. Son cuentas distintas, no un
# problema de permisos.
YCLOUD_WABA_ID=1102665725775760
YCLOUD_PHONE_NUMBER=+573150290928
YCLOUD_PHONE_NUMBER_ID=1343776285475377

# Consola > Developers > API key: https://www.ycloud.com/console/#/app/developers/apikey
# Se manda en el header `X-API-Key`. Quien la tenga escribe por WhatsApp como
# la empresa. En n8n vive en la credencial FuwQeM17hSh07Wal.
YCLOUD_API_KEY=

# Webhook de YCloud hacia n8n. Eventos suscritos:
#   whatsapp.inbound_message.received  -> mensaje del cliente
#   whatsapp.smb.message.echoes        -> el dueno respondio desde la app
# NO suscribir whatsapp.smb.history: volcaria el historial completo por aqui.
YCLOUD_WEBHOOK_N8N=https://conatia-bot.duckdns.org/webhook/ycloud-whatsapp
YCLOUD_WEBHOOK_ENDPOINT_ID=6a8b3f833a7ced1bf600652a

# --- WhatsApp vía Evolution API (ARCHIVADO 2026-08-23) -----------------------
# Estuvo vivo del 20 al 23 de agosto de 2026. Los nodos siguen en los workflows
# con sufijo (Evolution), disabled. Ver infra/evolution-api/README.md.
EVOLUTION_URL=https://evolution.conatia-bot.duckdns.org
EVOLUTION_INSTANCIA=brian-otero
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_N8N=https://conatia-bot.duckdns.org/webhook/evolution-whatsapp

# --- Gemini (modelo del agente) ----------------------------------------------
# La credencial vive en n8n; esta variable es para scripts que prueben aparte.
GOOGLE_GEMINI_API_KEY=

# --- n8n en VPS (produccion) -------------------------------------------------
# Instancia que reemplaza a la local como entorno de trabajo.
N8N_VPS_URL=https://conatia-bot.duckdns.org

# IDs en el VPS (distintos a los de la instancia local)
N8N_VPS_WORKFLOW_BRIAN_OTERO=NsJQxBhrNyrKFVJu
N8N_VPS_WORKFLOW_AGENDAR_CITA=w3p5TRsicq13Jmig
N8N_VPS_WORKFLOW_ENVIAR_MEDIOS=Tkh6deuiy663KNkl
N8N_VPS_WORKFLOW_SEGUIMIENTO=fWtN6n18kbcYyAga
N8N_VPS_WORKFLOW_SEPARAR_FECHA=Mxz7P208vVXhyNg9
N8N_VPS_CREDENCIAL_YCLOUD=FuwQeM17hSh07Wal
N8N_VPS_CREDENCIAL_POSTGRES=Ou3OkUR92F7f6ofK
N8N_VPS_API_KEY=

# --- Excel del equipo en Google Sheets (2026-09-01) -------------------------
# La hoja donde el bot anota cada fecha y cada cita que manda a Google Calendar,
# para que el calendario y el Excel del equipo dejen de ser dos verdades. Dos
# pestanas: `Reservas` (separar_fecha_evento) y `Citas` (agendar_cita).
# El ID no es secreto: sale de la URL, y sin permiso no sirve de nada.
EXCEL_AGENDA_SHEET_ID=1H1Sq3HGl0oWamnt7TLCg2X_Tvyj6blMF6TjJ7ihtDAA

# Credencial de n8n que escribe en esa hoja. Es una cuenta de servicio APARTE de
# la de Calendar, y de otro proyecto de Google Cloud (2026-09-02).
#
# El motivo: la Google Sheets API hay que habilitarla en el proyecto dueno de la
# CREDENCIAL que hace la llamada, NO donde vive la hoja. El proyecto del cliente
# (omega-dahlia-500617-g6) la tiene apagada y no hay forma de encenderla:
#   - la cuenta de servicio no tiene serviceusage.services.enable, ni permiso
#     para consultar siquiera el estado del servicio (comprobado contra la API);
#   - y a la consola de ese Google no se entra: pide verificacion en dos pasos
#     y la cuenta es del cliente.
# La salida es que la llamada la haga una cuenta de servicio de un proyecto
# NUESTRO. La hoja se queda donde esta; solo hay que compartirla con ella.
#
# La de Calendar no se toca: sigue en el proyecto del cliente y sigue sin poder
# tocar hojas de calculo. Esta solo lleva el scope .../auth/spreadsheets y solo
# puede hablar con sheets.googleapis.com.
#
# La llave va en `.gcp-sa-sheets.json` (el .gitignore ya cubre .gcp-sa-*.json).
# `scripts/credencial-sheets.js` la da de alta en n8n y repunta los dos nodos.
#
# Requiere, ademas, dos cosas que NO se configuran desde aqui:
#   1. La Google Sheets API habilitada en NUESTRO proyecto (gratis, sin facturacion).
#   2. La hoja compartida como Editor con el correo de esa cuenta de servicio.
N8N_VPS_CREDENCIAL_SHEETS=BKP31rWyOHmoLB2c
