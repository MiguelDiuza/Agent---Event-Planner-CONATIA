# =============================================================================
# Evolution API — variables de entorno
# =============================================================================
# Copiar a `.env` DENTRO de esta carpeta, en el VPS:  cp .env.example .env
# Este archivo se versiona; `.env` no. Nunca pegar valores reales aqui.
# -----------------------------------------------------------------------------

# --- Autenticacion -----------------------------------------------------------
# Clave maestra de la API. Va en el header `apikey` de TODAS las llamadas y es
# lo unico que protege la instancia: quien la tenga puede escribir por WhatsApp
# como la empresa. Generar una larga, nunca dejar el "mude-me" del ejemplo:
#   openssl rand -hex 32
AUTHENTICATION_API_KEY=

# --- Servidor ----------------------------------------------------------------
# URL publica con la que Evolution se referencia a si mismo (la usa para armar
# los links de los archivos multimedia que envia). Debe ser la URL real desde
# fuera, no localhost, o las fotos y videos llegaran rotos.
SERVER_URL=https://evolution.conatia-bot.duckdns.org

# --- Base de datos -----------------------------------------------------------
# Contraseña de la Postgres propia de Evolution (la del docker-compose).
# No tiene relacion con la de Supabase.  openssl rand -hex 16
POSTGRES_PASSWORD=

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:${POSTGRES_PASSWORD}@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution

# Que persiste en la base. Los mensajes se guardan para poder depurar
# conversaciones; el historico completo se deja en false porque al vincular
# arrastraria meses de chats viejos y dispararia el tamaño de la base.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# --- Cache -------------------------------------------------------------------
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
# En false a proposito: guardar la instancia en Redis hace que un flush de
# Redis desvincule el telefono. Las credenciales van al volumen en disco.
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# --- Webhook -----------------------------------------------------------------
# Se deja global desactivado: el webhook se configura POR INSTANCIA al crearla,
# apuntando al Webhook Trigger de n8n. Asi una segunda instancia de pruebas no
# dispara el flujo de produccion.
WEBHOOK_GLOBAL_ENABLED=false
# Un solo endpoint para todos los eventos. En true, Evolution le pega el nombre
# del evento a la URL (.../messages-upsert) y habria que crear un webhook por
# evento en n8n.
WEBHOOK_BY_EVENTS=false

# --- Comportamiento de la sesion ---------------------------------------------
# Cuantos QR regenera antes de rendirse. 30 da tiempo de sobra para escanear.
QRCODE_LIMIT=30
# En false: si el telefono se desconecta, la instancia NO se borra sola. Con
# true habria que rehacer toda la configuracion tras cualquier caida de red.
DEL_INSTANCE=false
# El bot no contesta llamadas de WhatsApp.
REJECT_CALL=false
# En false a proposito: marcar todo como leido le quitaria al equipo humano la
# señal de que hay mensajes sin atender.
READ_MESSAGES=false
# Mostrar el numero siempre en linea. En false para no delatar que es un bot.
ALWAYS_ONLINE=false

# --- Fingerprint de la sesion ------------------------------------------------
# Identificador de "navegador" que anuncia la sesion al vincularse. El valor por
# defecto de Evolution es "Evolution API", que WhatsApp no reconoce como cliente
# valido y hace que rechace el registro del dispositivo con 401. Con Ubuntu/Chrome
# vincula a la primera. Esto costo cuatro intentos fallidos de averiguar.
CONFIG_SESSION_PHONE_CLIENT=Ubuntu
CONFIG_SESSION_PHONE_NAME=Chrome

# NO fijar CONFIG_SESSION_PHONE_VERSION en la v2.3.7: pinearla a una version de
# cliente vieja reintroduce el 401. Solo hacia falta como parche en la v2.1.1.

# --- Logs --------------------------------------------------------------------
LOG_LEVEL=ERROR,WARN,INFO
# Baileys es extremadamente verboso en debug; dejarlo en error.
LOG_BAILEYS=error
